# Copy this file to .env and replace the placeholders. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose and the app) ---
POSTGRES_USER=teamforge
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=teamforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth (used from Milestone 4) ---
# Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
